<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="JMK_131_create-contracts-table" author="Sahib Singh">
        <createTable tableName="contracts">
            <column name="contract_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_posting_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="proposal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="freelancer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="deadline_date" type="DATE"/>
            <column name="offer_expiry_date" type="DATE"/>
            <column name="weekly_hour_limit" type="INTEGER"/>
            <column name="hourly_rate" type="INTEGER">
                <constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="contracts"/>
        </rollback>
    </changeSet>
</databaseChangeLog>