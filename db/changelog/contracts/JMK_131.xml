<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="JMK_131_create-contracts-table" author="Sahib Singh">
        <createTable tableName="contracts">
            <column name="contracts_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_posting_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="proposal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="freelancer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="deadline_date" type="DATE"/>
            <column name="offer_expiry_date" type="DATE"/>
            <column name="weekly_hour_limit" type="INTEGER"/>

            <column name="contract_type" type="VARCHAR(50)">
            <constraints nullable="false"/>
            </column>
            <column name="contract_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="hourly_rate" type="INTEGER">
                <constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            CREATE TYPE contract_type_enum AS ENUM (
            'FIXED',
            'HOURLY'
            );

            CREATE TYPE contract_status_enum AS ENUM (
            'ACTIVE',
            'PENDING',
            'COMPLETED',
            'CANCELLED'
            );

            ALTER TABLE contracts
            ADD COLUMN contract_type contract_type_enum NOT NULL;

            ALTER TABLE contracts
            ADD COLUMN contract_status contract_status_enum NOT NULL;
        </sql>

        <rollback>
            <dropTable tableName="contracts"/>
        </rollback>
    </changeSet>
</databaseChangeLog>