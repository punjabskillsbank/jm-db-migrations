<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="JMK_54_01_Fix_Jobs_Precondition" author="Pawanpreet Singh">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="jobs"/>
            </not>
        </preConditions>

        <comment>Fix for incorrect precondition in original jobs table changeSet (id=JMK_19_06).</comment>
    </changeSet>

    <changeSet id="JMK_54_02_Modify_Profile_Photo_URL_DataType" author="Pawanpreet Singh">

        <modifyDataType
            tableName="freelancers"
            columnName="profile_photo_url"
            newDataType="TEXT"/>

        <rollback>
            <modifyDataType
                tableName="freelancers"
                columnName="profile_photo_url"
                newDataType="VARCHAR(2048)"/>
        </rollback>
    </changeSet>

    <changeSet id="JMK_54_03_Modify_Certificate_ID_Datatype" author="Pawanpreet Singh">
        <!-- Drop the existing primary key constraint -->
        <dropPrimaryKey tableName="certificates" constraintName="certificates_pkey"/>

        <!-- Change the datatype from SERIAL to BIGSERIAL -->
        <modifyDataType
                tableName="certificates"
                columnName="certificate_id"
                newDataType="BIGSERIAL"/>

        <!-- Re-add the primary key constraint -->
        <addPrimaryKey
                tableName="certificates"
                columnNames="certificate_id"
                constraintName="certificates_pkey"/>

        <rollback>
            <!-- For rollback, first drop the primary key constraint -->
            <dropPrimaryKey tableName="certificates" constraintName="certificates_pkey"/>

            <!-- Change datatype back from BIGSERIAL to SERIAL -->
            <modifyDataType
                    tableName="certificates"
                    columnName="certificate_id"
                    newDataType="SERIAL"/>

            <!-- Re-add the primary key constraint -->
            <addPrimaryKey
                    tableName="certificates"
                    columnNames="certificate_id"
                    constraintName="certificates_pkey"/>
        </rollback>
    </changeSet>

    <changeSet id="JMK_54_04_Modify_Education_ID_Datatype" author="Pawanpreet Singh">
        <!-- Drop the existing primary key constraint -->
        <dropPrimaryKey tableName="educations" constraintName="educations_pkey"/>

        <!-- Change the datatype from SERIAL to BIGSERIAL -->
        <modifyDataType
                tableName="educations"
                columnName="education_id"
                newDataType="BIGSERIAL"/>

        <!-- Re-add the primary key constraint -->
        <addPrimaryKey
                tableName="educations"
                columnNames="education_id"
                constraintName="educations_pkey"/>

        <rollback>
            <!-- For rollback, first drop the primary key constraint -->
            <dropPrimaryKey tableName="certificates" constraintName="educations_pkey"/>

            <!-- Change datatype back from BIGSERIAL to SERIAL -->
            <modifyDataType
                    tableName="educations"
                    columnName="education_id"
                    newDataType="SERIAL"/>

            <!-- Re-add the primary key constraint -->
            <addPrimaryKey
                    tableName="educations"
                    columnNames="education_id"
                    constraintName="educations_pkey"/>
        </rollback>
    </changeSet>

    <changeSet id="JMK_54_05_Modify_Job_ID_Datatype" author="Pawanpreet Singh">
        <!-- Drop the existing primary key constraint -->
        <dropPrimaryKey tableName="jobs" constraintName="jobs_pkey"/>

        <!-- Change the datatype from SERIAL to BIGSERIAL -->
        <modifyDataType
                tableName="jobs"
                columnName="job_id"
                newDataType="BIGSERIAL"/>

        <!-- Re-add the primary key constraint -->
        <addPrimaryKey
                tableName="jobs"
                columnNames="job_id"
                constraintName="jobs_pkey"/>

        <rollback>
            <!-- For rollback, first drop the primary key constraint -->
            <dropPrimaryKey tableName="jobs" constraintName="jobs_pkey"/>

            <!-- Change datatype back from BIGSERIAL to SERIAL -->
            <modifyDataType
                    tableName="jobs"
                    columnName="job_id"
                    newDataType="SERIAL"/>

            <!-- Re-add the primary key constraint -->
            <addPrimaryKey
                    tableName="jobs"
                    columnNames="job_id"
                    constraintName="jobs_pkey"/>
        </rollback>
    </changeSet>

    <changeSet id="JMK_54_06_Modify_Profile_Photo_URL_DataType" author="Pawanpreet Singh">

        <modifyDataType
                tableName="clients"
                columnName="profile_photo_url"
                newDataType="TEXT"/>

        <rollback>
            <modifyDataType
                    tableName="clients"
                    columnName="profile_photo_url"
                    newDataType="VARCHAR(2048)"/>
        </rollback>
    </changeSet>


</databaseChangeLog>


